# TrendPulse Environment Configuration
# Copy this file to .env and fill in your Reddit API credentials
# To obtain credentials:
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click 'are you a developer? create an app...'
# 3. Select 'script'
# 4. Fill in name ('TrendPulse'), redirect uri ('http://localhost:8080')
# 5. Copy client_id (under app name) and client_secret

# Reddit Official API Credentials
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=TrendPulse:v1.0.0 (by /u/your_reddit_username)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Target subreddits (comma-separated)
REDDIT_SUBREDDITS=technology,artificial,science,wallstreetbets,MachineLearning

# Storage Configuration
# Options: csv, postgresql, sqlite
STORAGE_TYPE=csv
CSV_OUTPUT_PATH=data/raw/reddit_posts.csv

# PostgreSQL Configuration (used if STORAGE_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trendpulse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
